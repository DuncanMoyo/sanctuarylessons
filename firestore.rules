rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMissionDocId(id) {
      return id is string && id.size() >= 1 && id.size() <= 2 && id.matches('^[0-9]{1,2}$');
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidIntList(arr, maxLen) {
      return arr is list
        && arr.size() <= maxLen
        && (arr.size() == 0 || (arr[0] is int && arr[0] >= 0 && arr[0] <= 12));
    }

    function isValidVerseList(arr, maxLen) {
      return arr is list
        && arr.size() <= maxLen
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 16));
    }

    function isValidStudyProfile(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'completedMissions',
          'quizBonusEarned',
          'readVerses',
          'xp',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'completedMissions',
          'quizBonusEarned',
          'readVerses',
          'xp',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() <= 128
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && isValidIntList(data.completedMissions, 13)
        && isValidIntList(data.quizBonusEarned, 13)
        && isValidVerseList(data.readVerses, 100)
        && data.xp is int
        && data.xp >= 0
        && data.xp <= 5000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMissionNote(data, userId, missionId) {
      return data.keys().hasAll([
          'ownerId',
          'missionId',
          'content',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'missionId',
          'content',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() <= 128
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.missionId is string
        && data.missionId.size() <= 2
        && isValidMissionDocId(data.missionId)
        && data.missionId == missionId
        && data.content is string
        && data.content.size() <= 5000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /studyProfiles/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidStudyProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidStudyProfile(incoming(), userId)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'completedMissions',
          'quizBonusEarned',
          'readVerses',
          'xp',
          'updatedAt'
        ])
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isValidId(userId) && isOwner(userId);

      match /notes/{missionId} {
        allow get: if isValidId(userId)
          && isValidMissionDocId(missionId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/studyProfiles/$(userId));

        allow list: if isValidId(userId)
          && isOwner(userId)
          && resource.data.ownerId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidMissionDocId(missionId)
          && isOwner(userId)
          && isValidMissionNote(incoming(), userId, missionId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/studyProfiles/$(userId));

        allow update: if isValidId(userId)
          && isValidMissionDocId(missionId)
          && isOwner(userId)
          && isValidMissionNote(incoming(), userId, missionId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'content',
            'updatedAt'
          ])
          && incoming().ownerId == existing().ownerId
          && incoming().missionId == existing().missionId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/studyProfiles/$(userId));

        allow delete: if isValidId(userId)
          && isValidMissionDocId(missionId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/studyProfiles/$(userId));
      }
    }
  }
}
